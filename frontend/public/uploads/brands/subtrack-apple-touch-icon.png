<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SubTrack — Subscription Manager</title>
  <meta name="description" content="Multi-user web-based subscription tracker with auto reminders and calendar integration." />
  <link rel="stylesheet" href="/static/css/app.css" />
</head>
<body>
  <div id="app">
    <!-- Header Navigation -->
    <header class="navbar apple-nav">
      <div class="container nav-content">
        <a href="#/login" class="brand">
          <div class="brand-icon">💳</div>
          <span class="brand-title">SubTrack <span class="badge-pro">PRO</span></span>
        </a>
        
        <!-- Public Landing Navigation -->
        <div id="landing-nav" class="landing-nav-links">
          <a href="#overview" class="nav-anchor">Overview</a>
          <a href="#radar" class="nav-anchor">Renewal Radar</a>
          <a href="#calendar-sync" class="nav-anchor">Calendar Sync</a>
          <a href="#bento-features" class="nav-anchor">Architecture</a>
          <a href="#live-demo" class="nav-anchor">Live Demo</a>
        </div>

        <!-- Public Auth Action Buttons -->
        <div id="landing-auth" class="landing-auth-actions">
          <button type="button" id="btn-nav-login" class="btn btn-sm btn-apple-ghost">Sign In</button>
          <button type="button" id="btn-nav-register" class="btn btn-sm btn-apple-primary">Get Started</button>
        </div>

        <!-- Authenticated Dashboard Navigation -->
        <div id="main-nav" class="nav-links" style="display: none;">
          <a href="#/dashboard" class="nav-link">Dashboard</a>
          <a href="#/settings" class="nav-link">Settings</a>
          <div class="user-badge">
            <span id="nav-user-email">user@example.com</span>
          </div>
          <button id="btn-logout" class="btn btn-sm btn-secondary">Logout</button>
        </div>
      </div>
    </header>

    <!-- MAIN VIEW CONTAINER -->
    <main style="flex: 1; width: 100%;">

      <!-- PAGE: APPLE PRO FLAGSHIP LANDING PAGE -->
      <section id="page-login" class="page-view" style="display: none;">
        <div class="landing-page-wrap">
          
          <!-- Hero Section -->
          <div id="overview" class="apple-hero-section">
            <div class="apple-eyebrow">✦ The Recurring Intelligence Suite</div>
            <h1 class="apple-hero-title">Master your recurring world.</h1>
            <p class="apple-hero-sub">
              Formidable tracking. Zero friction. Total clarity over every renewal date, billing cycle, and subscription cost across iPhone, Mac, and web.
            </p>
            <div class="apple-hero-ctas">
              <button type="button" class="btn btn-apple-primary btn-lg" id="btn-hero-start">Start Tracking Free</button>
              <button type="button" class="btn btn-apple-ghost btn-lg" id="btn-hero-signin">Sign In to Portal</button>
            </div>

            <!-- Apple Keynote 3D Hardware Visual -->
            <div class="apple-hero-visual">
              <div class="hero-visual-glow"></div>
              <div class="hero-annotation-pill top-left">
                <span class="status-dot green"></span> Live RFC 5545 Sync: Apple Calendar • Google • Outlook
              </div>
              <div class="hero-annotation-pill bottom-right">
                <span class="status-dot blue"></span> Renewal Radar: 7d • 3d • 1d smart notifications
              </div>
              <div class="apple-hero-img-wrap">
                <img src="/static/img/hero-device.jpg" alt="SubTrack Pro Flagship Interface" class="apple-hero-img" />
              </div>
            </div>
          </div>

          <!-- Metrics Ribbon -->
          <div class="apple-metrics-bar">
            <div class="metric-item">
              <div class="metric-number">45+</div>
              <div class="metric-label">Currencies Converted</div>
            </div>
            <div class="metric-item">
              <div class="metric-number">0</div>
              <div class="metric-label">Surprise Card Charges</div>
            </div>
            <div class="metric-item">
              <div class="metric-number">100%</div>
              <div class="metric-label">Zero-Telemetry Privacy</div>
            </div>
            <div class="metric-item">
              <div class="metric-number">&lt; 2 min</div>
              <div class="metric-label">Instant Cloud Setup</div>
            </div>
          </div>

          <!-- Section: Bento Grid Architecture -->
          <div id="bento-features">
            <div class="apple-section-header">
              <div class="apple-section-tag">ENGINEERED FOR SUPREMACY</div>
              <h2 class="apple-section-title">Built like titanium. Focused on what matters.</h2>
              <p class="apple-section-desc">
                SubTrack is not a bloated expense sheet. It is a focused command center engineered from the ground up for high-precision subscription mastery.
              </p>
            </div>

            <div class="apple-bento-grid">
              
              <!-- Card 1: Renewal Radar (Span 2) -->
              <div id="radar" class="bento-card span-2">
                <div>
                  <span class="bento-badge">PROACTIVE RADAR</span>
                  <h3 class="bento-title">Alerts before charges land. Never after.</h3>
                  <p class="bento-desc">
                    Timezone-aware reminder engine checks your recurring schedule at 8:00 AM every morning. Receive consolidated digests and phone pushes at 7, 3, and 1 days before a charge hits your card.
                  </p>
                </div>
                <div class="bento-visual">
                  <div class="radar-timeline">
                    <div class="radar-item">
                      <div class="radar-name"><span>🎬</span> Netflix Ultra HD</div>
                      <span class="radar-due soon">Charges in 3 days ($24.99)</span>
                    </div>
                    <div class="radar-item">
                      <div class="radar-name"><span>🎧</span> Spotify Family</div>
                      <span class="radar-due ready">Charges in 7 days ($11.99)</span>
                    </div>
                    <div class="radar-item">
                      <div class="radar-name"><span>☁️</span> AWS Cloud Infrastructure</div>
                      <span class="radar-due ready">Charges in 18 days ($42.50)</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Card 2: Universal Currency (Span 1) -->
              <div class="bento-card span-1">
                <div>
                  <span class="bento-badge">GLOBAL CONVERSION</span>
                  <h3 class="bento-title">Zero mental math.</h3>
                  <p class="bento-desc">
                    Mix international subscriptions effortlessly. Track services in USD, EUR, GBP, PKR, INR, AED, or CAD with unified single-currency aggregation.
                  </p>
                </div>
                <div class="bento-visual">
                  <div class="currency-pills">
                    <span class="currency-pill active">USD $</span>
                    <span class="currency-pill">EUR €</span>
                    <span class="currency-pill">GBP £</span>
                    <span class="currency-pill">PKR Rs</span>
                    <span class="currency-pill">INR ₹</span>
                    <span class="currency-pill">AED</span>
                    <span class="currency-pill">CAD</span>
                    <span class="currency-pill">JPY ¥</span>
                  </div>
                </div>
              </div>

              <!-- Card 3: Live Calendar Feed (Span 1) -->
              <div id="calendar-sync" class="bento-card span-1">
                <div>
                  <span class="bento-badge">NATIVE ECOSYSTEM</span>
                  <h3 class="bento-title">Always where you look.</h3>
                  <p class="bento-desc">
                    Subscribe once with your private 256-bit RFC 5545 iCalendar URL. Real-time renewal events display natively on your iPhone, Apple Watch, iPad, and Mac.
                  </p>
                </div>
                <div class="bento-visual">
                  <div class="calendar-feed-preview">
                    <div class="cal-icon">🗓️</div>
                    <div class="cal-text">
                      <div style="font-weight:600; font-size:0.85rem; color:#fff;">Apple Calendar Feed</div>
                      <code>https://subs.arshadaleem.com/api/calendar/feed?token=***</code>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Card 4: Security Core (Span 2) -->
              <div id="security" class="bento-card span-2">
                <div>
                  <span class="bento-badge">ZERO-TELEMETRY PRIVACY</span>
                  <h3 class="bento-title">Your finances belong to your eyes alone.</h3>
                  <p class="bento-desc">
                    Protected by industry-standard Argon2id cryptographic hashing, isolated multi-tenant records, and zero third-party telemetry or tracking cookies. Complete data portability with 1-click SQLite & CSV backup.
                  </p>
                </div>
                <div class="bento-visual">
                  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
                    <div style="display:flex; align-items:center; gap:0.6rem;">
                      <span style="font-size:1.3rem;">🛡️</span>
                      <div>
                        <div style="font-weight:600; font-size:0.85rem; color:#fff;">Argon2id Password Cryptography</div>
                        <div style="font-size:0.75rem; color:var(--apple-text-secondary);">256-bit cryptographically secure session cookies</div>
                      </div>
                    </div>
                    <span class="radar-due ready" style="font-size:0.8rem;">Active Guard</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Section: Live Demo Simulation -->
          <div id="live-demo" class="demo-showcase-container">
            <div class="demo-header-bar">
              <div>
                <h3 style="font-size: 1.3rem; font-weight: 700; color: #fff;">Interactive Interface Preview</h3>
                <p style="font-size: 0.85rem; color: var(--apple-text-secondary); margin-top: 0.2rem;">Experience the SubTrack Pro command dashboard</p>
              </div>
              <div class="demo-pills">
                <span class="radar-due ready">Live Database</span>
                <span class="radar-due soon">Next Alert: Oct 14</span>
              </div>
            </div>

            <div class="demo-stat-row">
              <div class="demo-stat-card">
                <div class="demo-stat-title">Monthly Total</div>
                <div class="demo-stat-val">$67.47</div>
              </div>
              <div class="demo-stat-card">
                <div class="demo-stat-title">Active Services</div>
                <div class="demo-stat-val">5 Active</div>
              </div>
              <div class="demo-stat-card">
                <div class="demo-stat-title">Yearly Projection</div>
                <div class="demo-stat-val">$809.64</div>
              </div>
            </div>

            <table class="demo-table-mock">
              <thead>
                <tr>
                  <th>Service</th>
                  <th>Category</th>
                  <th>Renewal Date</th>
                  <th>Cycle</th>
                  <th>Cost</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>🎬 Netflix</strong></td>
                  <td>Entertainment</td>
                  <td>Oct 14, 2026</td>
                  <td>Monthly</td>
                  <td>$24.99</td>
                  <td><span class="radar-due soon">In 3 days</span></td>
                </tr>
                <tr>
                  <td><strong>🎧 Spotify Family</strong></td>
                  <td>Audio</td>
                  <td>Oct 18, 2026</td>
                  <td>Monthly</td>
                  <td>$11.99</td>
                  <td><span class="radar-due ready">In 7 days</span></td>
                </tr>
                <tr>
                  <td><strong>☁️ iCloud+ 2TB</strong></td>
                  <td>Cloud Storage</td>
                  <td>Nov 02, 2026</td>
                  <td>Monthly</td>
                  <td>$9.99</td>
                  <td><span class="radar-due ready">Active</span></td>
                </tr>
                <tr>
                  <td><strong>🤖 ChatGPT Plus</strong></td>
                  <td>AI Productivity</td>
                  <td>Nov 08, 2026</td>
                  <td>Monthly</td>
                  <td>$20.00</td>
                  <td><span class="radar-due ready">Active</span></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Pre-Footer CTA Banner -->
          <div class="apple-cta-banner">
            <h2 class="cta-banner-title">Your subscriptions. Finally in sharp focus.</h2>
            <p class="cta-banner-desc">
              Join users tracking recurring services with titanium precision. Free forever, self-contained, and completely ad-free.
            </p>
            <button type="button" class="btn btn-apple-primary btn-lg" id="btn-banner-start">Create Your Free Account</button>
          </div>

          <!-- Apple Minimalist Footer -->
          <footer class="apple-footer">
            <div class="footer-content">
              <div>
                © 2026 SubTrack Pro. All rights reserved. RFC 5545 iCalendar compliant.
              </div>
              <div class="footer-links">
                <a href="#overview">Overview</a>
                <a href="#radar">Renewal Radar</a>
                <a href="#security">Security</a>
                <a href="#/login" id="link-footer-login">Sign In</a>
              </div>
            </div>
          </footer>

        </div>
      </section>

      <!-- PAGE: STANDALONE REGISTER (Redirects to Auth Modal) -->
      <section id="page-register" class="page-view" style="display: none;"></section>

      <!-- MODAL: APPLE PRO AUTHENTICATION (SIGN IN & REGISTER) -->
      <div id="modal-auth" class="modal-overlay">
        <div class="card auth-modal-card">
          <div class="modal-header" style="margin-bottom: 1.25rem;">
            <div class="brand">
              <div class="brand-icon">💳</div>
              <span class="brand-title">SubTrack <span class="badge-pro">PRO</span></span>
            </div>
            <button type="button" class="close-btn close-auth-btn">&times;</button>
          </div>

          <div class="auth-tabs">
            <button type="button" id="tab-login" class="auth-tab-btn active">Sign In</button>
            <button type="button" id="tab-register" class="auth-tab-btn">Create Account</button>
          </div>

          <!-- Tab: Sign In -->
          <div id="auth-panel-login">
            <form id="form-login">
              <div class="form-group">
                <label class="form-label" for="login-email">Email Address</label>
                <input type="email" id="login-email" class="form-control" autocomplete="username" placeholder="you@domain.com" required />
              </div>
              <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <label class="form-label" for="login-password">Password</label>
                  <a href="#/forgot" style="font-size: 0.8rem; color: var(--apple-blue-vibrant);">Forgot?</a>
                </div>
                <input type="password" id="login-password" class="form-control" autocomplete="current-password" required />
              </div>
              <button type="submit" class="btn btn-apple-primary" style="width: 100%; margin-top: 0.5rem;">Sign In</button>
            </form>

            <div class="auth-divider">OR</div>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <a href="/auth/google/start" class="btn btn-google" style="width: 100%;">
                <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                Sign in with Google
              </a>
              <a href="/auth/apple/start" class="btn btn-apple" style="width: 100%;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.54c.67-.82 1.13-1.96.99-3.11-1 .04-2.19.67-2.88 1.48-.62.72-1.15 1.88-1 3.01 1.11.09 2.23-.56 2.89-1.38z"/></svg>
                Sign in with Apple
              </a>
            </div>
          </div>

          <!-- Tab: Create Account -->
          <div id="auth-panel-register" style="display: none;">
            <form id="form-register">
              <div class="form-group">
                <label class="form-label" for="reg-name">Full Name</label>
                <input type="text" id="reg-name" class="form-control" autocomplete="name" placeholder="John Doe" />
              </div>

              <div class="form-group">
                <label class="form-label" for="reg-email">Email Address</label>
                <input type="email" id="reg-email" class="form-control" autocomplete="email" placeholder="you@domain.com" required />
              </div>

              <div class="form-group">
                <label class="form-label" for="reg-password">Password (min 10 chars, mix of types)</label>
                <input type="password" id="reg-password" class="form-control" autocomplete="new-password" required minlength="10" />
              </div>

              <div class="form-group">
                <label class="form-label" for="reg-currency">Default Account Currency</label>
                <select id="reg-currency" class="form-control">
                  <option value="USD">USD ($)</option>
                  <option value="PKR">PKR (Rs)</option>
                  <option value="EUR">EUR (€)</option>
                  <option value="GBP">GBP (£)</option>
                  <option value="INR">INR (₹)</option>
                  <option value="AED">AED (AED)</option>
                  <option value="CAD">CAD (CA$)</option>
                  <option value="AUD">AUD (A$)</option>
                </select>
              </div>

              <button type="submit" class="btn btn-apple-primary" style="width: 100%; margin-top: 0.5rem;">Create Account</button>
            </form>
          </div>
        </div>
      </div>

      <!-- PAGE: FORGOT PASSWORD -->
      <section id="page-forgot" class="page-view auth-wrapper" style="display: none;">
        <div class="card auth-card">
          <div class="auth-header">
            <h1>Reset Password</h1>
            <p style="color: var(--text-muted); font-size: 0.9rem;">We'll email you a secure link</p>
          </div>
          <form id="form-forgot">
            <div class="form-group">
              <label class="form-label" for="forgot-email">Account Email Address</label>
              <input type="email" id="forgot-email" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Send Reset Link</button>
          </form>
          <p style="text-align: center; margin-top: 1.5rem; font-size: 0.875rem;">
            <a href="#/login" style="color: var(--primary);">Back to Login</a>
          </p>
        </div>
      </section>

      <!-- PAGE: RESET PASSWORD -->
      <section id="page-reset" class="page-view auth-wrapper" style="display: none;">
        <div class="card auth-card">
          <div class="auth-header">
            <h1>Choose New Password</h1>
          </div>
          <form id="form-reset">
            <input type="hidden" id="reset-token" />
            <div class="form-group">
              <label class="form-label" for="reset-password">New Password</label>
              <input type="password" id="reset-password" class="form-control" required minlength="10" />
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Update Password</button>
          </form>
        </div>
      </section>

      <!-- PAGE: VERIFY EMAIL STATUS -->
      <section id="page-verify" class="page-view auth-wrapper" style="display: none;">
        <div class="card auth-card" style="text-align: center;">
          <h2>Email Verification</h2>
          <p id="verify-status" style="margin-top: 1rem; color: var(--text-muted);">Verifying link...</p>
        </div>
      </section>

      <!-- PAGE: DASHBOARD -->
      <section id="page-dashboard" class="page-view" style="display: none;">
        <!-- KPI Cards Grid -->
        <div class="kpi-grid">
          <div class="card kpi-card">
            <span class="kpi-label">Total Active</span>
            <span id="kpi-active" class="kpi-value">0</span>
          </div>
          <div class="card kpi-card">
            <span class="kpi-label">Monthly Spend</span>
            <span id="kpi-monthly" class="kpi-value">$0.00</span>
          </div>
          <div class="card kpi-card">
            <span class="kpi-label">Yearly Spend</span>
            <span id="kpi-yearly" class="kpi-value">$0.00</span>
          </div>
          <div class="card kpi-card">
            <span class="kpi-label">Due in 7 Days</span>
            <span id="kpi-due-7" class="kpi-value">0</span>
          </div>
        </div>

        <!-- Toolbar & Filter Actions -->
        <div class="toolbar">
          <div class="toolbar-actions">
            <button id="btn-add-sub" class="btn btn-primary">+ Add Subscription</button>
            <button id="btn-import-sub" class="btn btn-secondary">📥 Import File</button>
            <a href="/api/export.csv" class="btn btn-secondary">📤 Export CSV</a>
            <button id="btn-bulk-delete" class="btn btn-danger" style="display: none;"></button>
          </div>

          <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <input type="search" id="search-input" class="form-control" placeholder="Search service, email, card..." style="width: 220px;" />
            <div class="filter-group">
              <button class="filter-chip active" data-filter="all">All</button>
              <button class="filter-chip" data-filter="active">Active</button>
              <button class="filter-chip" data-filter="cancelled">Cancelled</button>
              <button class="filter-chip" data-filter="due_this_month">Due This Month</button>
              <button class="filter-chip" data-filter="overdue">Overdue</button>
            </div>
          </div>
        </div>

        <!-- Data Table -->
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th style="width: 40px;"></th>
                <th>Service Name</th>
                <th>Email Address</th>
                <th>Card / Method</th>
                <th>Renewal Date</th>
                <th>Status / Due</th>
                <th>Amount</th>
                <th>Cycle</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody id="subs-table-body">
              <!-- Rendered via Dashboard.js -->
            </tbody>
          </table>
        </div>

        <!-- Visible Totals Bar -->
        <div class="totals-bar">
          <span style="font-weight: 500; color: var(--text-muted);">Visible Subscriptions Monthly Total:</span>
          <span id="visible-total-amount" style="font-size: 1.25rem; font-weight: 700; color: var(--accent-cyan);">$0.00</span>
        </div>
      </section>

      <!-- PAGE: SETTINGS -->
      <section id="page-settings" class="page-view" style="display: none;">
        <h1 style="font-size: 1.75rem; margin-bottom: 1.5rem;">Account & Notification Settings</h1>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
          <!-- Profile & Currency Form -->
          <div class="card">
            <h2 style="font-size: 1.15rem; margin-bottom: 1rem;">User Profile</h2>
            <form id="form-profile">
              <div class="form-group">
                <label class="form-label" for="setting-profile-name">Full Name</label>
                <input type="text" id="setting-profile-name" class="form-control" />
              </div>

              <div class="form-group">
                <label class="form-label" for="setting-profile-currency">Display Currency (App-wide)</label>
                <select id="setting-profile-currency" class="form-control">
                  <option value="USD">USD ($)</option>
                  <option value="PKR">PKR (Rs)</option>
                  <option value="EUR">EUR (€)</option>
                  <option value="GBP">GBP (£)</option>
                  <option value="INR">INR (₹)</option>
                  <option value="AED">AED (AED)</option>
                  <option value="CAD">CAD (CA$)</option>
                  <option value="AUD">AUD (A$)</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="setting-profile-timezone">Timezone</label>
                <input type="text" id="setting-profile-timezone" class="form-control" placeholder="Asia/Karachi" />
              </div>

              <button type="submit" class="btn btn-primary" style="width: 100%;">Save Profile</button>
            </form>
          </div>

          <!-- Calendar Feed -->
          <div class="card">
            <h2 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Calendar Integration (ICS Feed)</h2>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
              Subscribe in Apple Calendar, Google Calendar, or Outlook to see upcoming renewals on your phone/laptop.
            </p>
            <div class="form-group">
              <input type="text" id="setting-calendar-url" class="form-control" readonly />
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button id="btn-copy-cal" class="btn btn-secondary" style="flex: 1;">Copy Feed Link</button>
              <button id="btn-regen-cal" class="btn btn-danger btn-sm">Regenerate</button>
            </div>
          </div>

          <!-- Notification Settings -->
          <div class="card" style="grid-column: 1 / -1;">
            <h2 style="font-size: 1.15rem; margin-bottom: 1rem;">Alert Preferences</h2>
            <form id="form-notifications">
              <div class="form-group">
                <label class="form-label">Alert Timing (Days Before Renewal)</label>
                <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.35rem;">
                  <label><input type="checkbox" class="notify-day-checkbox" value="7" /> 7 days before</label>
                  <label><input type="checkbox" class="notify-day-checkbox" value="3" /> 3 days before</label>
                  <label><input type="checkbox" class="notify-day-checkbox" value="1" /> 1 day before</label>
                  <label><input type="checkbox" class="notify-day-checkbox" value="0" /> Due today (0 days)</label>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label><input type="checkbox" id="setting-email-alerts" /> Enable Email Alerts</label>
                  <input type="email" id="setting-alert-email" class="form-control" placeholder="Alert recipient email (optional)" style="margin-top: 0.5rem;" />
                </div>

                <div class="form-group">
                  <label class="form-label" for="setting-ntfy-topic">ntfy.sh Push Topic (Phone Alerts)</label>
                  <input type="text" id="setting-ntfy-topic" class="form-control" placeholder="my-private-subtrack-topic" />
                </div>
              </div>

              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <button type="submit" class="btn btn-primary">Save Preferences</button>
                <button type="button" id="btn-test-email" class="btn btn-secondary">Test Email</button>
                <button type="button" id="btn-test-push" class="btn btn-secondary">Test Push</button>
              </div>
            </form>
          </div>

          <!-- Active Sessions -->
          <div class="card" style="grid-column: 1 / -1;">
            <h2 style="font-size: 1.15rem; margin-bottom: 1rem;">Active Logged-In Devices</h2>
            <div id="sessions-list">
              <!-- Rendered via Settings.js -->
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- MODAL: ADD / EDIT SUBSCRIPTION -->
    <div id="modal-sub" class="modal-overlay">
      <div class="card modal-card">
        <div class="modal-header">
          <h2 id="modal-sub-title">Add Subscription</h2>
          <button class="close-btn close-modal-btn">&times;</button>
        </div>
        <form id="form-sub">
          <div class="form-group">
            <label class="form-label" for="sub-name">Service Name *</label>
            <input type="text" id="sub-name" class="form-control" placeholder="Netflix, Spotify, ChatGPT..." required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="sub-email">Account Email</label>
              <input type="email" id="sub-email" class="form-control" placeholder="user@gmail.com" />
            </div>
            <div class="form-group">
              <label class="form-label" for="sub-card">Payment Card / Method</label>
              <input type="text" id="sub-card" class="form-control" placeholder="Visa Debit ending 1234" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="sub-date">Renewal Date *</label>
              <input type="date" id="sub-date" class="form-control" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="sub-amount">Amount *</label>
              <input type="number" step="0.01" id="sub-amount" class="form-control" placeholder="15.99" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="sub-cycle">Billing Cycle</label>
              <select id="sub-cycle" class="form-control">
                <option value="monthly">Monthly</option>
                <option value="yearly">Yearly</option>
                <option value="weekly">Weekly</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label><input type="checkbox" id="sub-active" checked /> Active Subscription</label>
          </div>
          <div class="form-group">
            <label class="form-label" for="sub-notes">Notes</label>
            <textarea id="sub-notes" class="form-control" rows="2"></textarea>
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1rem;">
            <button type="button" class="btn btn-secondary close-modal-btn">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Subscription</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL: FILE IMPORT -->
    <div id="modal-import" class="modal-overlay">
      <div class="card modal-card">
        <div class="modal-header">
          <h2>Import Subscriptions File</h2>
          <button class="close-btn close-modal-btn">&times;</button>
        </div>
        <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem;">
          Select your desktop <code>subscriptions.db</code> SQLite database file or a CSV spreadsheet file to import.
        </p>
        <form id="form-import">
          <div class="form-group">
            <label class="form-label" for="import-file">Select File (.db or .csv)</label>
            <input type="file" id="import-file" class="form-control" accept=".db,.sqlite,.sqlite3,.csv" required />
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1rem;">
            <button type="button" class="btn btn-secondary close-modal-btn">Cancel</button>
            <button type="submit" class="btn btn-primary">Start Import</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container"></div>

    <!-- Local Dev Mailbox Drawer -->
    <div id="dev-mailbox-drawer" class="dev-mailbox-drawer" style="display: none;"></div>
  </div>

  <script src="/static/js/api.js"></script>
  <script src="/static/js/auth.js"></script>
  <script src="/static/js/dashboard.js"></script>
  <script src="/static/js/settings.js"></script>
  <script src="/static/js/app.js"></script>
</body>
</html>
